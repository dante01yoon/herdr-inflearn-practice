{
  "id": "root",
  "type": "column",
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "board",
      "type": "block",
      "size": {
        "px": 240
      },
      "min": 120,
      "max": 600,
      "content": {
        "mod": "agent-board"
      }
    },
    {
      "id": "tabs",
      "type": "block",
      "size": {
        "px": 42
      },
      "content": {
        "mod": "tabs-timer"
      }
    },
    {
      "id": "main",
      "type": "block",
      "content": {
        "tab": "active",
        "pane": {
          "gap": 6,
          "radius": 6,
          "background": "background",
          "border": {
            "width": 1,
            "color": "border"
          },
          "focus": {
            "width": 1,
            "color": "accent"
          },
          "header": {
            "content": {
              "mod": "pane"
            },
            "reveal": "always",
            "height": 30,
            "position": "top"
          }
        }
      }
    },
    {
      "id": "status",
      "type": "block",
      "size": {
        "px": 28
      },
      "content": {
        "mod": "workspace-status"
      }
    }
  ]
}